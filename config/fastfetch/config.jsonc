{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Debian"
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    }
  },
  "modules": [
    "title",
    "os",
    "kernel",
    "uptime",
    "packages",
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "WM" },
    "terminal",
    "cpu",
    "memory",
    "swap",
    { "type": "disk", "folders": ["/"] },
    "battery",
    "localip"
  ]
}
