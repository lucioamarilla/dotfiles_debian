/* =============================================================
   theme-dark.rasi — Tokyo Night (dotfiles Debian)
   ============================================================= */
* {
    bg: rgba ( 22, 22, 30, 97 % );
    bg2: rgba ( 26, 27, 38, 100 % );
    fg: rgba ( 192, 202, 245, 100 % );
    fg2: rgba ( 169, 177, 214, 100 % );
    accent: rgba ( 122, 162, 247, 100 % );
    accent2: rgba ( 255, 158, 100, 100 % );
    alert: rgba ( 247, 118, 142, 100 % );
    disabled: rgba ( 86, 95, 137, 100 % );

    background-color: transparent;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg;
    border: 1;
    border-color: @accent2;
    border-radius: 8px;
    width: 30%;
    location: center;
    anchor: center;
}

mainbox {
    background-color: @bg;
    margin: 8px;
    spacing: 8px;
}

inputbar {
    background-color: @bg2;
    border-radius: 6px;
    padding: 8px 10px;
    spacing: 8px;
    text-color: @fg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
    placeholder: "Buscar…";
    placeholder-color: @disabled;
    cursor: text;
}

listview {
    lines: 9;
    fixed-lines: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    background-color: transparent;
    text-color: @fg2;
    padding: 4px 8px;
    border-radius: 6px;
}

element selected.normal {
    background-color: @accent;
    text-color: #16161e;
}

element selected.urgent {
    background-color: @alert;
    text-color: #16161e;
}

element alternate.normal {
    background-color: rgba ( 26, 27, 38, 60 % );
}

element-icon {
    size: 1.4em;
    padding: 0px 6px 0px 0px;
}

element-text {
    text-color: inherit;
}

mode-switcher {
    background-color: @bg2;
    border-radius: 6px;
}

button {
    text-color: @fg2;
    padding: 6px;
}

button selected {
    background-color: @accent;
    text-color: #16161e;
}
