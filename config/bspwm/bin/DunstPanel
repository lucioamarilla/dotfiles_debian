#!/bin/sh
# =============================================================
# DunstPanel — historial de notificaciones dunst + menú rofi
# (remplazo de JaKoolit swaync panel; ligero)
# apt: rofi, dunst (dunstctl)
# =============================================================

T="$HOME/.config/rofi/themes/theme-active.rasi"

actions=$(printf '<ver> historial\n<marcar-todas> leídas\n<limpiar> config' \
    | rofi -dmenu -i -p "Dunst" -theme "$T" 2>/dev/null)

case "$actions" in
    *historial*|*ver*|"")
        # listar el historial y elegir: abre o marca leída
        dunstctl history 2>/dev/null | python3 -c 'import json,sys
try:
    data = json.load(sys.stdin)["data"][0]
except Exception:
    sys.exit(0)
for i, n in enumerate(data, start=1):
    app, msg = n[4], n[5]
    msg = msg.replace("\n", " ; ")[:60]
    print(f"{i}. [{app}] {msg}")' \
        | rofi -dmenu -i -p "Notificaciones" -theme "$T" 2>/dev/null
        ;;
    *leídas*) dunstctl close-all 2>/dev/null ;;
    *limpiar*) dunstctl history-pop 2>/dev/null ;;
esac
