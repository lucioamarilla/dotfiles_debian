# Icon directory
vol_dir="$HOME/.config/bspwm/config/assets"

notify() {
    dunstify -u low -h string:x-dunst-stack-tag:cvolum "$@"
}

# Get volume status (prints "muted" or a bare number, no %)
get_volume() {
    v=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print $5}' | head -n1)
    [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ] && { echo muted; return; }
    echo "${v%\%}"
}

# Determine icon based on a volume value (muted|0|N)
get_icon() {
    case "$1" in
        muted|0) icon="$vol_dir/mute.png" ;;
        *) icon="$vol_dir/vol.png" ;;
    esac
}

# Show notification
show_notification() {
    local vol

    vol=$(get_volume)
    get_icon "$vol"

    if [ "$vol" = "muted" ]; then
        notify -i "$icon" "Volumen: muted"
    else
        notify -i "$icon" "Volumen: ${vol}%"
    fi
}

# Adjust volume
adjust_volume() {
    pactl set-sink-mute @DEFAULT_SINK@ 0
    case "$1" in
        -i) pactl set-sink-volume @DEFAULT_SINK@ "+5%" ;;
        -d) pactl set-sink-volume @DEFAULT_SINK@ "-5%" ;;
    esac
    show_notification
}

# Toggle mute
toggle_mute() {
    local vol

    pactl set-sink-mute @DEFAULT_SINK@ toggle

    if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
        get_icon muted
        notify -i "$icon" "Muted"
    else
        vol=$(get_volume)
        get_icon "$vol"
        notify -i "$icon" "Unmuted"
    fi
}

# Toggle mic mute (XF86AudioMicMute — fuente de captura por defecto)
toggle_mic() {
    pactl set-source-mute @DEFAULT_SOURCE@ toggle
    if [ "$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
        get_icon muted
        notify -i "$icon" "Mic muted"
    else
        notify -i icon-mic "Mic active"
    fi
}

# Handle options
case "$1" in
    --get)    get_volume ;;
    --inc)    adjust_volume -i 5 ;;
    --dec)    adjust_volume -d 5 ;;
    --toggle) toggle_mute ;;
    --mic)    toggle_mic ;;
    *)
        vol=$(get_volume)
        case "$vol" in
            muted) echo muted ;;
            *) echo "${vol}%" ;;
        esac
        ;;
esac
