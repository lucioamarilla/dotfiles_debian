#!/bin/sh
# =============================================================
# Brightness — brillo pantalla con dunst bar (port gh0stzk)
# apt: brightnessctl, dunst
# =============================================================

STEPS=5
MIN=2

extract_pct() { awk -F '[()%]' '/Current brightness:/ {print $2}'; }
get_b() { brightnessctl i 2>/dev/null | extract_pct; }

notify_b() {
    dunstify "Brillo $1%" -r 5555 -h int:value:"$1"
}

adjust() {
    cur=$(get_b)
    [ -z "$cur" ] && cur=50

    case "$1" in
        up)
            if [ "$cur" -le "$MIN" ]; then
                set="$STEPS%"
            else
                set="${STEPS}%+"
            fi
            ;;
        down)
            threshold=$((MIN + STEPS))
            if [ "$cur" -le "$threshold" ]; then
                set="${MIN}%"
            else
                set="${STEPS}%-"
            fi
            ;;
    esac
    new=$(brightnessctl set "$set" 2>/dev/null | extract_pct)
    notify_b "$new"
}

case "$1" in
    up|down) adjust "$1" ;;
    *) get_b ;;
esac
