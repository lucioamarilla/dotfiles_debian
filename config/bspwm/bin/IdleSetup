#!/bin/sh
# =============================================================
# IdleSetup — autolock + DPMS (ThinkPad-friendly)
# apt: xautolock, x11-xserver-utils
# Uso: IdleSetup (inicio) | --toggle | --status
# Nota: en VMs se auto-desactiva (autolock en pruebas molesta).
# =============================================================

# VMs: sin autolock (systemd-detect-virt siempre presente en Arch)
case "$(systemd-detect-virt -v 2>/dev/null)" in
    oracle|kvm|vmware|qemu|bochs|msvm|uml) exit 0 ;;
esac

case "$1" in
    --status|-s)
        pidof -x xautolock >/dev/null 2>&1 && echo on || echo off
        exit 0 ;;
    --toggle|-t)
        pkill -USR1 xautolock 2>/dev/null
        if pidof -x xautolock >/dev/null 2>&1; then
            xautolock -disable
        else
            xautolock -enable
        fi
        exit 0 ;;
esac

pidof -x xautolock >/dev/null 2>&1 && { pkill -USR1 xautolock 2>/dev/null; exit 0; }

xautolock -time 10 -locker "$HOME/.config/bin/scripts/ScreenLocker" -detectsleep &
xset s 900 60
xset dpms 1800 2400 3000
exit 0
