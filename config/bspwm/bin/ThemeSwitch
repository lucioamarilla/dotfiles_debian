#!/bin/sh
# =============================================================
# ThemeSwitch — cambia tema dark/light al vuelo
#
# Temas  : ~/.config/bspwm/themes/<nombre>.sh  (variables COLOR)
# Español: polybar colors.ini (regenerado), bordes bspwm, rofi.
#
# Uso: ThemeSwitch --menu | --set dark|light | --sync
# =============================================================

THEMES_DIR="$HOME/.config/bspwm/themes"
STATE="$HOME/.config/bspwm/.theme"
POLY_COLORS="$HOME/.config/polybar/colors.ini"
ROFI_THEMES="$HOME/.config/rofi/themes"

current() {
    if [ -f "$STATE" ]; then
        read -r T <"$STATE" && echo "$T" || echo dark
    else
        echo dark
    fi
}

apply_theme() {
    THEME="$1"
    [ -f "$THEMES_DIR/$THEME.sh" ] || { echo "Tema no existe: $THEME" >&2; return 1; }

    # Cargar variables del tema
    . "$THEMES_DIR/$THEME.sh"

    # Guardar estado
    echo "$THEME" > "$STATE"

    # polybar: regenerar colors.ini
    if [ -d "$HOME/.config/polybar" ]; then
        cat > "$POLY_COLORS.tmp" <<EOF
[colors]
background   = $BG
background2  = $BG2
foreground   = $FG
foreground2  = $FG2
primary      = $ACCENT
secondary    = $ACCENT2
alert        = $ALERT
disabled     = $DISABLED
urgent       = $URGENT
ws-active-fg = $WS_ACTIVE_FG
ws-active-bg = $WS_ACTIVE_BG
border       = $BORDER
EOF
        mv "$POLY_COLORS.tmp" "$POLY_COLORS"
    fi

    # rofi: symlink theme-active.rasi
    if [ -d "$ROFI_THEMES" ]; then
        ln -sfn "theme-$THEME.rasi" "$ROFI_THEMES/theme-active.rasi"
    fi

    # BSPWM: colores del borde/focus
    bspc config focused_border_color  "$ACCENT"   2>/dev/null
    bspc config normal_border_color   "$BORDER"   2>/dev/null
    bspc config presel_feedback_color "$ACCENT2"  2>/dev/null
    bspc config urgent_border_color   "$URGENT"   2>/dev/null
    bspc config active_border_color   "$ACCENT2"  2>/dev/null

    # dunst: cambios de tema sólo en próxima recarga (estable)
    pkill -USR1 dunst 2>/dev/null

    # polybar restart (launch.sh)
    [ -x "$HOME/.config/polybar/launch.sh" ] && \
        "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
}

case "$1" in
    --menu|"")
        CHOICE=$(printf 'dark\nlight\n' | rofi -dmenu -p "Tema" \
            -theme "$ROFI_THEMES/applet.rasi" 2>/dev/null)
        [ -n "$CHOICE" ] && apply_theme "$CHOICE" && dunstify -t 1200 "Tema" "$CHOICE aplicado"
        ;;
    --set|"")
        apply_theme "$2" 2>/dev/null || apply_theme "$1"
        ;;
    --select)
        apply_theme "$2"
        ;;
    --sync)
        apply_theme "$(current)"
        ;;
    --get)
        current ;;
esac
