#!/bin/sh
# =============================================================
# Rofimoji — emoji picker (JaKoolit RofiEmoji, port X11)
# pipx: pipx install rofimoji (no empaquetado en Debian 13)
# =============================================================

ARGS="--action copy --files math,symbols,emoticons,geometric-shapes"

if command -v rofimoji >/dev/null 2>&1; then
    exec rofimoji $ARGS "$@"
elif [ -x "$HOME/.local/bin/rofimoji" ]; then
    exec "$HOME/.local/bin/rofimoji" $ARGS "$@"
else
    dunstify -t 2000 "Emoji" "Instalá: pipx install rofimoji"
    exit 1
fi
