#!/bin/sh
# =============================================================
# Rofimoji — emoji picker (JaKoolit RofiEmoji port)
# apt: rofimoji
# =============================================================

if command -v rofimoji >/dev/null 2>&1; then
    exec rofimoji --action copy --files "math,symbols,emoticons,geometric-shapes" "$@"
else
    dunstify -t 2000 "Emoji" "Instalá: sudo apt install rofimoji"
fi
